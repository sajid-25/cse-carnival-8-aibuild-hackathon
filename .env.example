# CampusOS Environment Variables
# Copy this file to .env and fill in your actual values. Never commit .env to git.

# Database URL for MySQL (used by Prisma)
DATABASE_URL="mysql://root:password@localhost:3306/campusos"

# LLM Provider API Keys (Vercel AI SDK)
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"
GOOGLE_GENERATIVE_AI_API_KEY="your-google-api-key"

# Server Configuration
PORT=3000
NODE_ENV="development"
